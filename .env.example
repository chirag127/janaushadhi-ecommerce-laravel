APP_NAME="Jan Aushadhi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Shared InsForge PostgreSQL (raw PG, NOT the JS SDK) ---
# Laravel READS the shared public.products / public.categories catalog and
# WRITES its own laravel_-prefixed tables (auth, sessions, cart, orders, etc.).
DB_CONNECTION=pgsql
DB_HOST=ht574p3t.us-east.database.insforge.app
DB_PORT=5432
DB_DATABASE=insforge
DB_USERNAME=postgres
DB_PASSWORD=b108a0a0dd940ab35d916f1bec464b5f
DB_SSLMODE=require
DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@janaushadhi.example"
MAIL_FROM_NAME="${APP_NAME} Store"

# --- Store business config ---
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL="₹"
STORE_SHIPPING_FEE=40
STORE_FREE_SHIPPING_THRESHOLD=500
STORE_TAX_RATE=0
STORE_PRODUCTS_PER_PAGE=24
STORE_SUPPORT_EMAIL=support@janaushadhi.example
STORE_SUPPORT_PHONE=1800-XXX-XXXX

VITE_APP_NAME="${APP_NAME}"
