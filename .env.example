APP_NAME="Jan Aushadhi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Neon PostgreSQL (shared janaushadhi catalog+commerce DB) ---
# DATABASE_URL is the single connection string from 'neon env pull'.
# It covers both the shared catalog (products/categories) and Laravel-local
# laravel_-prefixed tables (users, cart, orders, etc.) on the same Neon project.
# Neon project: sweet-silence-15535482 (org org-old-mode-74272352, aws-us-east-2)
# Run 'neon env pull' after cloning to populate DATABASE_URL locally.
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@janaushadhi.example"
MAIL_FROM_NAME="${APP_NAME} Store"

# --- Store business config ---
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL="₹"
STORE_SHIPPING_FEE=40
STORE_FREE_SHIPPING_THRESHOLD=500
STORE_TAX_RATE=0
STORE_PRODUCTS_PER_PAGE=24
STORE_SUPPORT_EMAIL=support@janaushadhi.example
STORE_SUPPORT_PHONE=1800-XXX-XXXX

VITE_APP_NAME="${APP_NAME}"

# --- Razorpay (test mode) — online payment path (COD works without these) ---
# Get test keys from Razorpay Dashboard > Test Mode > Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# --- Social login (OAuth) ---
# Get credentials from each provider's developer console. Set the redirect/
# callback URL to <APP_URL>/auth/<provider>/callback.
# Same email links to one account (existing laravel_users row is reused).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
